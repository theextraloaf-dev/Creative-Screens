---
/* Three benefit cards in one outlined container: big stat, bold title, one line (kigo-style).
   Stats are facts we hold (21 years, 8 services, one team); no unconfirmed numbers here. */
import { messages, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const w = messages(locale).why;
---

<section class="why section" aria-labelledby="why-title">
  <div class="wrap">
    <p class="why__eyebrow">{w.eyebrow}</p>
    <h2 id="why-title" data-text-reveal>{w.title}</h2>
    <ul class="why__grid">
      {w.items.map((c, i) => (
        <li data-reveal data-delay={i * 0.08}>
          <p class="why__stat"><bdi dir="ltr">{c.stat}</bdi><small>{c.unit}</small></p>
          <h3>{c.t}</h3>
          <p>{c.d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why__eyebrow { font-family: var(--font-mono); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.06em; color: var(--grey); margin: 0 0 0.5rem; }
  .why h2 { font-size: var(--step-3); margin-block-end: var(--space-3); }
  .why__grid { list-style: none; margin: 0; padding: 0; display: grid; border: 1.5px solid var(--ink); border-radius: 22px; background: var(--white); overflow: hidden; }
  .why__grid li { padding: clamp(1.25rem, 3vw, 2rem); border-block-end: 1px solid var(--hairline); display: grid; align-content: start; gap: 0.5rem; }
  .why__grid li:last-child { border-block-end: 0; }
  .why__stat { margin: 0; display: flex; align-items: baseline; gap: 0.5rem; font-family: var(--font-num); font-size: clamp(3.4rem, 8vw, 5.5rem); line-height: 1; color: var(--ink); }
  .why__stat small { font-family: var(--font-mono); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.06em; padding: 0.15rem 0.55rem; border-radius: var(--pill); background: var(--lime); color: var(--navy); }
  .why__grid h3 { margin: 0.4rem 0 0; font-size: var(--step-1); }
  .why__grid p:not(.why__stat) { margin: 0; color: var(--grey); max-width: 30ch; }
  @media (min-width: 860px) {
    .why__grid { grid-template-columns: repeat(3, 1fr); }
    .why__grid li { border-block-end: 0; border-inline-end: 1px solid var(--hairline); }
    .why__grid li:last-child { border-inline-end: 0; }
  }
</style>
