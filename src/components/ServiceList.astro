---
/* Services as a plain index list: each row is a link to the quote area (hub pages come later). */
import { messages, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const m = messages(locale);
---

<section class="svc section" id="services" aria-labelledby="svc-title">
  <div class="wrap">
    <h2 id="svc-title" data-text-reveal>{m.services.title}</h2>
    <ol class="svc__list">
      {m.services.items.map((s, i) => (
        <li data-reveal data-delay={Math.min(i, 5) * 0.05}>
          <a href="#quote" data-service={s.slug}>
            <span class="svc__no">{String(i + 1).padStart(2, '0')}</span>
            <span class="svc__name"><span>{s.name}</span></span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .svc h2 { font-size: var(--step-3); margin-block-end: var(--space-3); }
  .svc__list { list-style: none; margin: 0; padding: 0; border-block-start: 1px solid var(--hairline); }
  .svc__list a {
    display: grid; grid-template-columns: 2.6rem 1fr auto; align-items: baseline; gap: 0.5rem;
    padding-block: 0.9rem; border-block-end: 1px solid var(--hairline); text-decoration: none;
    font-family: var(--font-display); font-weight: 600; font-size: var(--step-1); line-height: 1.25;
  }
  html[lang='ar'] .svc__list a { font-weight: 700; line-height: 1.6; }
  .svc__no { font-family: var(--font-mono); font-weight: 400; font-size: var(--step--1); color: var(--grey); }
  .svc__name span {
    background: linear-gradient(var(--lime), var(--lime)) no-repeat; background-size: 0% 100%;
    background-position: var(--origin-start) 0; padding-inline: 0.3em; margin-inline: -0.3em;
    box-decoration-break: clone; -webkit-box-decoration-break: clone; transition: background-size 0.45s var(--ease-out);
  }
  @media (min-width: 900px) {
    .svc .wrap { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr); gap: var(--space-4); align-items: start; }
    .svc h2 { margin-block-end: 0; position: sticky; inset-block-start: calc(var(--header-h) + var(--space-3)); }
  }
  .arrow { opacity: 0; transition: opacity var(--dur-fast), transform var(--dur-ink) var(--ease-out); }
  .svc__list a:hover .svc__name span, .svc__list a:focus-visible .svc__name span { background-size: 100% 100%; }
  .svc__list a:hover .arrow, .svc__list a:focus-visible .arrow { opacity: 1; }
</style>
