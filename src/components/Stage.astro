---
/* Vehicle graphic sequence, drawn as a blueprint: the Creative Screens logo is traced, printed and cut on a
   print-and-cut machine, then applied to a pickup door. Concept illustration, never client work.
   Layout rule: the truck is never mirrored; in Arabic the bench sits on the right and sweeps run right-to-left. */
import { messages, type Locale } from '../i18n';
import creativeSvg from '../../public/img/logo-creative.svg?raw';
import screensSvg from '../../public/img/logo-screens.svg?raw';

interface Props { locale: Locale; id?: string }
const { locale, id = 'process' } = Astro.props;
const m = messages(locale);
const rtl = locale === 'ar';
const pathOf = (svg: string) => svg.match(/ d="([^"]+)"/)?.[1] ?? '';

// Layout numbers (SVG user units, viewBox 0 0 1200 560). Bench and truck each draw in their own local space.
const truckX = rtl ? 20 : 580;
const benchX = rtl ? 640 : 0;
const rr = (x: number, y: number, w: number, h: number, r: number) =>
  `M${x + r} ${y} H${x + w - r} A${r} ${r} 0 0 1 ${x + w} ${y + r} V${y + h - r} A${r} ${r} 0 0 1 ${x + w - r} ${y + h} H${x + r} A${r} ${r} 0 0 1 ${x} ${y + h - r} V${y + r} A${r} ${r} 0 0 1 ${x + r} ${y} Z`;
const sheet = { x: 80, y: 170, w: 400, h: 230 };
const dc = { x: 110, y: 220, w: 340, h: 135, cx: 280, cy: 287.5 }; // decal contour (bench space)
const contour = rr(dc.x, dc.y, dc.w, dc.h, 20);
const logoS = 0.616;
const creativeT = `translate(${dc.cx - (487 * logoS) / 2} 240) scale(${logoS})`;
const screensT = `translate(${dc.cx - (468 * logoS) / 2} ${240 + 66 * logoS + 14}) scale(${logoS})`;
const door = { cx: 357, cy: 350 }; // door panel centre (truck space)
const decalScale = 0.46;
const dx = truckX + door.cx - (benchX + dc.cx);
const dy = door.cy - dc.cy;
const sqA = door.cx - 82;
const sqB = door.cx + 82;
const bubbles = [[300, 330], [334, 366], [374, 336], [412, 362]];
const regs = rtl ? [[465, 185], [95, 185], [465, 385]] : [[95, 185], [465, 185], [95, 385]];
const ticks = Array.from({ length: 21 }, (_, i) => sheet.x + i * 20);
const spokes = (cx: number, cy: number) =>
  Array.from({ length: 5 }, (_, k) => {
    const a = (k * 2 * Math.PI) / 5 - Math.PI / 2;
    return `M${(cx + 10 * Math.cos(a)).toFixed(1)} ${(cy + 10 * Math.sin(a)).toFixed(1)} L${(cx + 30 * Math.cos(a)).toFixed(1)} ${(cy + 30 * Math.sin(a)).toFixed(1)}`;
  }).join(' ');
const dim = (x1: number, x2: number, y: number) => `M${x1} ${y} H${x2} M${x1} ${y - 7} V${y + 7} M${x2} ${y - 7} V${y + 7}`;

// Pointer labels: [timeline in, out, anchor selector, anchor point]
const noteAt: [number, number, string, string][] = [
  [1, 8, '.trace', 'top'], [8, 13, '.dims', 'top'], [13, 21, '.chips', 'top'], [20, 27, '.rail', 'top'],
  [26, 40, '.carriage', 'top'], [39, 46, '.reg', 'top'], [46, 58, '.knife', 'top'], [59, 66, '.waste', 'top'],
  [65, 72, '.tape', 'top'], [71, 80, '.doorzone', 'top'], [79, 86, '.decal', 'top'], [86, 94, '.squeegee', 'top'],
  [93, 97, '.decal', 'top'], [97, 101, '.wheel', 'top'],
];
const ink = '#131d27';
const lime = '#bbd440';
const cutRed = '#e8432a';
---

<section class="stage" data-stage id={id} aria-labelledby={`${id}-title`}>
  <div class="stage__pin">
    <div class="wrap stage__inner">
      <div class="stage__top">
        <p class="eyebrow">{m.sequence.concept}</p>
        <a class="stage__skip" href="#quote">{m.cta.skip}</a>
      </div>
      <h2 id={`${id}-title`} data-text-reveal>{m.sequence.title}</h2>

      <div class="stage__art">
        <svg
          viewBox="0 0 1200 560"
          role="img"
          aria-label={m.sequence.static}
          data-dx={dx}
          data-dy={dy}
          data-sq-start={rtl ? sqB : sqA}
          data-sq-end={rtl ? sqA : sqB}
          data-bench-x={benchX}
          data-truck-x={truckX}
          style={`--static-shift: ${600 - (truckX + 300)}px`}
          data-rtl={rtl ? '1' : '0'}>
          <defs>
            <pattern id={`${id}-grid`} width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M40 0 H0 V40" fill="none" stroke={ink} stroke-opacity="0.07" stroke-width="1"></path>
            </pattern>
            <!-- the printed decal: navy ground, lime logo -->
            <g id={`${id}-art`}>
              <path d={contour} fill={ink}></path>
              <path d={pathOf(creativeSvg)} transform={creativeT} fill={lime} fill-rule="evenodd"></path>
              <path d={pathOf(screensSvg)} transform={screensT} fill={lime} fill-rule="evenodd"></path>
            </g>
            <clipPath id={`${id}-ink`}><rect class="ink-rect" x={dc.x - 4} y={dc.y - 6} width="0" height={dc.h + 12}></rect></clipPath>
          </defs>

          <g class="world">
            <rect x="-600" y="-300" width="2400" height="1160" fill={`url(#${id}-grid)`}></rect>

            <!-- ===== Pickup truck, side elevation (never mirrored) ===== -->
            <g class="truck" transform={`translate(${truckX} 0)`} fill="#fff" stroke={ink} stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
              <path d="M-30 470 H640" fill="none" stroke-width="1.5"></path>
              <path d="M110 360 V488 M470 360 V488" fill="none" stroke-width="1" stroke-dasharray="10 4 2 4" stroke-opacity="0.45"></path>
              <path d="M0 410 V330 H250 V246 Q252 236 262 236 H392 Q402 236 408 246 L452 300 H574 Q596 304 598 322 V410 H530 A60 60 0 0 0 410 410 H170 A60 60 0 0 0 50 410 Z"></path>
              <path d="M270 248 H390 Q397 248 401 254 L434 296 H270 Z" fill="#eef1f4"></path>
              <path d="M262 240 V408 M452 300 V408 M8 344 H244 M14 334 V406" fill="none" stroke-width="1.5"></path>
              <rect x="276" y="312" width="24" height="6" rx="3" fill="none" stroke-width="1.5"></rect>
              <path d="M436 284 H452 V298 H436 Z" stroke-width="1.5"></path>
              <rect x="584" y="318" width="12" height="14" rx="3" stroke-width="1.5"></rect>
              <rect x="0" y="340" width="8" height="20" stroke-width="1.5"></rect>
              <rect x="586" y="380" width="18" height="28" rx="4" stroke-width="1.5"></rect>
              <rect x="-8" y="384" width="16" height="24" rx="3" stroke-width="1.5"></rect>
              {[110, 470].map((cx) => (
                <g class={cx === 470 ? 'wheel wheel-front' : 'wheel'}>
                  <circle cx={cx} cy="424" r="46"></circle>
                  <circle cx={cx} cy="424" r="32" fill="none" stroke-width="1.5"></circle>
                  <circle cx={cx} cy="424" r="7" stroke-width="1.5"></circle>
                  <path class="spoke" data-wx={cx} d={spokes(cx, 424)} fill="none" stroke-width="1.5"></path>
                </g>
              ))}
              <!-- target zone on the door, and its dimension -->
              <rect class="doorzone anim-only" x={door.cx - 82} y={door.cy - 34} width="164" height="68" rx="6" fill="none" stroke={ink} stroke-width="1.5" stroke-dasharray="6 5" opacity="0"></rect>
              <g class="doordim anim-only" opacity="0" stroke-width="1.5" fill="none">
                <path d={dim(262, 452, 500)}></path>
                <text x="357" y="526" text-anchor="middle" stroke="none" fill={ink} font-size="17" font-family="DM Mono, ui-monospace, monospace">900 mm</text>
              </g>
              <!-- final applied frame when motion is off -->
              <use class="static-only" href={`#${id}-art`} transform={`translate(${door.cx} ${door.cy}) scale(${decalScale}) translate(${-dc.cx} ${-dc.cy})`}></use>
              <!-- application: bubbles and squeegee -->
              <g class="anim-only" fill="#fff" fill-opacity="0.7" stroke={ink} stroke-width="1.2">
                {bubbles.map(([cx, cy]) => <circle class="bubble" cx={cx} cy={cy} r="6" opacity="0"></circle>)}
              </g>
              <g class="anim-only squeegee" opacity="0" stroke="none">
                <rect x={(rtl ? sqB : sqA) - 5} y={door.cy - 46} width="10" height="92" rx="4" fill={ink}></rect>
                <rect x={(rtl ? sqB : sqA) - 5} y={door.cy - 46} width="10" height="12" rx="4" fill={lime}></rect>
              </g>
            </g>

            <!-- ===== Bench: vinyl sheet on the print-and-cut machine ===== -->
            <g class="anim-only bench" transform={`translate(${benchX} 0)`}>
              <g class="sheet">
                <rect x={sheet.x} y={sheet.y} width={sheet.w} height={sheet.h} fill="#fff" stroke={ink} stroke-width="1.5"></rect>
                <path d={ticks.map((x, i) => `M${x} ${sheet.y - (i % 5 === 0 ? 12 : 6)} V${sheet.y}`).join(' ')} stroke={ink} stroke-width="1" fill="none"></path>
              </g>

              <!-- waste vinyl with the decal cut out; peels away after cutting -->
              <path class="waste" fill-rule="evenodd" fill="#f4f6f8" stroke="none" d={`M${sheet.x} ${sheet.y} H${sheet.x + sheet.w} V${sheet.y + sheet.h} H${sheet.x} Z ${contour}`}></path>

              <g class="dims" opacity="0" fill="none" stroke={ink} stroke-width="1.2">
                <path d={dim(dc.x, dc.x + dc.w, 204)}></path>
                <text x={dc.cx} y="197" text-anchor="middle" stroke="none" fill={ink} font-size="15" font-family="DM Mono, ui-monospace, monospace">600 mm</text>
                <path d={`M466 ${dc.y} V${dc.y + dc.h} M459 ${dc.y} H473 M459 ${dc.y + dc.h} H473`}></path>
                <text x="0" y="0" transform={`translate(478 ${dc.cy}) rotate(90)`} text-anchor="middle" stroke="none" fill={ink} font-size="15" font-family="DM Mono, ui-monospace, monospace">240 mm</text>
              </g>

              <g class="regs" fill="none" stroke={ink} stroke-width="1.5">
                {regs.map(([x, y]) => (
                  <g class="reg" opacity="0"><circle cx={x} cy={y} r="6"></circle><path d={`M${x - 10} ${y} H${x + 10} M${x} ${y - 10} V${y + 10}`}></path></g>
                ))}
              </g>

              <!-- the decal: traced outline, printed ink, cut line, transfer tape -->
              <g class="decal">
                <g class="trace" fill="none" stroke={ink}>
                  <path d={contour} stroke-width="1.2" stroke-dasharray="6 5" stroke-opacity="0.6"></path>
                  <path class="trace-line" d={pathOf(creativeSvg)} transform={creativeT} pathLength="1" stroke-width="1.2" vector-effect="non-scaling-stroke" stroke-dasharray="1" stroke-dashoffset="1"></path>
                  <path class="trace-line" d={pathOf(screensSvg)} transform={screensT} pathLength="1" stroke-width="1.2" vector-effect="non-scaling-stroke" stroke-dasharray="1" stroke-dashoffset="1"></path>
                </g>
                <use href={`#${id}-art`} clip-path={`url(#${id}-ink)`}></use>
                <path class="cutline" d={contour} pathLength="1" fill="none" stroke={cutRed} stroke-width="2.5" stroke-dasharray="1" stroke-dashoffset="1"></path>
                <rect class="tape" x={dc.x - 8} y={dc.y - 8} width={dc.w + 16} height={dc.h + 16} rx="4" fill={ink} fill-opacity="0.08" stroke={ink} stroke-width="1.2" stroke-dasharray="4 4" opacity="0"></rect>
              </g>

              <g class="chips" fill="none" stroke={ink} stroke-width="1.5">
                {[[ink, 230], [lime, 280], ['#ffffff', 330]].map(([c, x]) => (
                  <g class="chip" opacity="0">
                    <rect x={Number(x) - 16} y="428" width="32" height="24" rx="3" fill={c}></rect>
                    <path class="tick" d={`M${Number(x) - 6} 440 L${Number(x) - 1} 445 L${Number(x) + 7} 435`} pathLength="1" stroke={c === ink ? '#fff' : ink} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1" stroke-dashoffset="1"></path>
                  </g>
                ))}
              </g>

              <!-- print-and-cut machine: rail, housings, moving carriage, blade -->
              <g class="machine" opacity="0" stroke={ink} stroke-width="1.5">
                <rect x="40" y="118" width="32" height="296" rx="4" fill="#fff"></rect>
                <rect x="488" y="118" width="32" height="296" rx="4" fill="#fff"></rect>
                <rect class="rail" x="40" y="128" width="480" height="18" rx="3" fill="#eef1f4"></rect>
                <line class="arm" x1="0" y1="0" x2="0" y2="0" stroke-width="1.2" stroke-dasharray="3 3" opacity="0"></line>
                <circle class="knife" cx="0" cy="0" r="6" fill={cutRed} stroke="#fff" stroke-width="2" opacity="0"></circle>
                <g class="carriage">
                  <rect class="printline" x="-2" y="152" width="4" height="248" fill={lime} stroke="none" opacity="0"></rect>
                  <rect x="-20" y="112" width="40" height="50" rx="5" fill={ink}></rect>
                  <rect x="-12" y="120" width="24" height="6" rx="2" fill={lime} stroke="none"></rect>
                </g>
              </g>
            </g>
          </g>
        </svg>
        <ol class="stage__notes" aria-hidden="true">
          {m.sequence.notes.map((t, i) => (
            <li data-note data-in={noteAt[i][0]} data-out={noteAt[i][1]} data-anchor={noteAt[i][2]} data-at={noteAt[i][3]}>
              <span class="note"><b>{t}</b><i></i><em></em></span>
            </li>
          ))}
        </ol>
        <ul class="stage__callouts" data-callouts aria-hidden="true">
          {[['hood', m.anatomy.hood], ['windshield', m.anatomy.windshield], ['roof', m.anatomy.roof], ['boot', m.anatomy.boot],
            ['glass', m.anatomy.glass], ['door', m.anatomy.door], ['wheel', m.anatomy.wheel], ['bumper', m.anatomy.bumper],
            ['backing', m.layers.backing], ['adhesive', m.layers.adhesive], ['vinyl', m.layers.vinyl], ['laminate', m.layers.laminate],
            ['applied', m.anatomy.applied]].map(([k, t]) => (
            <li data-co={k}><span class="co"><i></i><b>{t}</b></span></li>
          ))}
        </ul>
      </div>

      <div class="stage__live" aria-hidden="true">
        <div class="stage__caption">
          {m.sequence.steps.map((s, i) => (
            <p class={`cap cap-${i}`}><strong>{i + 1}. {s.title}</strong> {s.caption}</p>
          ))}
        </div>
        <ol class="stage__rail">
          {m.sequence.steps.map((s) => <li><span>{s.title}</span></li>)}
        </ol>
      </div>

      <div class="stage__proof" data-proof>
        <div class="ph">{m.sequence.proof}</div>
        <a class="btn" href="#quote">{m.sequence.cta} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <!-- Always in the DOM: the readable version of the four beats. Cards when motion is off. -->
  <ol class="stage__list wrap">
    {m.sequence.steps.map((s, i) => (
      <li><span class="eyebrow">0{i + 1}</span><h3>{s.title}</h3><p>{s.caption}</p></li>
    ))}
  </ol>
</section>

<style>
  .stage { position: relative; background: var(--paper); }
  .stage__pin { padding-block: calc(var(--header-h) + var(--space-4)) var(--space-4); }
  .stage__inner { display: grid; gap: var(--space-2); }
  .stage__art svg { width: 100%; height: auto; max-height: 46svh; margin-inline: auto; direction: ltr; overflow: hidden; }
  .stage__live { display: none; }
  .stage__top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .stage__skip {
    font-weight: 700;
    font-size: var(--step--1);
    white-space: nowrap;
  }
  .stage__proof { display: grid; gap: var(--space-2); align-items: center; }
  .stage__proof .ph { min-height: 5rem; }
  .stage__list {
    list-style: none;
    margin-block: var(--space-4) 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .stage__list li { padding: var(--space-3); border: 1px solid var(--hairline); border-radius: var(--radius); background: var(--white); }
  .stage__list h3 { font-size: var(--step-1); margin-block: 0.4rem; }
  .stage__list p { color: var(--grey); }
  @media (min-width: 720px) {
    .stage__list { grid-template-columns: repeat(4, 1fr); }
    .stage__proof { grid-template-columns: 1fr auto; }
  }

  /* ---- Motion on: sticky stage, scrubbed by stage.js ---- */
  :global(html:not(.motion)) .anim-only { display: none; }
  /* still frame: centre the finished truck */
  :global(html:not(.motion)) .stage__art .world { transform: translateX(var(--static-shift)); }
  :global(html.motion) .static-only { display: none; }
  :global(html.motion) .stage { height: 250vh; }
  /* bottom clearance keeps the proof CTA above the phone bar */
  :global(html.motion) .stage__pin { position: sticky; top: 0; height: 100svh; padding-block: calc(var(--header-h) + var(--space-2)) 5rem; display: grid; align-content: safe center; }
  :global(html.motion) .stage__inner { gap: var(--space-1); }
  :global(html.motion) .stage__proof .ph { min-height: 3rem; padding: 0.5rem 1rem; }
  :global(html.motion) .stage h2 { font-size: var(--step-2); }
  :global(html.motion) .stage__live { display: grid; gap: var(--space-2); }
  :global(html.motion) .stage__list { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); margin: 0; }
  :global(html.motion) .stage__art svg { max-height: 36svh; }
  .stage__caption { display: grid; min-height: 3.4em; }
  .cap { grid-area: 1 / 1; opacity: 0; transform: translateY(8px); transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out); font-size: var(--step-1); }
  .cap strong { font-family: var(--font-display); }
  .stage[data-step='0'] .cap-0, .stage[data-step='1'] .cap-1, .stage[data-step='2'] .cap-2, .stage[data-step='3'] .cap-3 { opacity: 1; transform: none; }
  .stage__rail { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; counter-reset: s; }
  .stage__rail li { counter-increment: s; border-block-start: 3px solid var(--hairline); padding-block-start: 0.5rem; font-family: var(--font-mono); font-size: var(--step--1); color: var(--grey); transition: border-color 0.3s, color 0.3s; }
  .stage__rail li::before { content: '0' counter(s) ' '; }
  .stage[data-step='0'] .stage__rail li:nth-child(-n + 1),
  .stage[data-step='1'] .stage__rail li:nth-child(-n + 2),
  .stage[data-step='2'] .stage__rail li:nth-child(-n + 3),
  .stage[data-step='3'] .stage__rail li:nth-child(-n + 4) { border-color: var(--ink); color: var(--ink); }
  @media (min-width: 900px) {
    :global(html.motion) .stage__pin { padding-block-end: var(--space-3); }
    :global(html.motion) .stage__proof .ph { min-height: 5rem; }
    :global(html.motion) .stage { height: 320vh; }
    :global(html.motion) .stage__art svg { max-height: 54svh; }
  }

  /* ---- 2D pointer labels: placed by stage.js on the part they name ---- */
  .stage__notes { display: none; list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; pointer-events: none; }
  :global(html.motion) .stage:not([data-mode='3d']) .stage__notes { display: block; }
  .stage__notes li { position: absolute; left: 0; top: 0; opacity: 0; transition: opacity 0.25s var(--ease-out); will-change: transform; }
  .stage__notes li:global(.is-on) { opacity: 1; }
  .note { position: absolute; left: 0; top: 0; direction: ltr; display: flex; flex-direction: column; align-items: flex-start; transform: translate(-5px, calc(-100% + 5px)); }
  .note b { unicode-bidi: plaintext; white-space: nowrap; font-family: var(--font-mono); font-weight: 400; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink); background: var(--paper); border: 1px solid var(--ink); padding: 0.2rem 0.4rem; }
  .note i { display: block; width: 1px; height: 1.1rem; margin-inline-start: 4.5px; background: var(--ink); }
  .note em { display: block; width: 10px; height: 10px; border-radius: 50%; background: var(--lime); border: 1px solid var(--ink); }
  li:global(.is-flip) .note { align-items: flex-end; transform: translate(calc(-100% + 5px), calc(-100% + 5px)); }
  li:global(.is-flip) .note i { margin-inline: 0 4.5px; }
  li:global(.is-below) .note { flex-direction: column-reverse; transform: translate(-5px, -5px); }
  li:global(.is-below.is-flip) .note { transform: translate(calc(-100% + 5px), -5px); }
  @media (min-width: 900px) { .note b { font-size: 0.8rem; padding: 0.25rem 0.5rem; } }

  /* ---- 3D mode: canvas replaces the SVG; HTML callouts follow the parts ---- */
  .stage__art { position: relative; }
  .stage[data-mode='3d'] .stage__art svg { display: none; }
  .stage[data-mode='3d'] .stage__art { height: clamp(15rem, 44svh, 36rem); }
  :global(.stage__canvas) { display: block; width: 100%; height: 100%; }
  .stage__callouts { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .stage__callouts li { position: absolute; left: 0; top: 0; opacity: 0; transition: opacity 0.35s var(--ease-out); will-change: transform; }
  .stage__callouts li:global(.is-on) { opacity: 1; }
  .co { direction: ltr; display: flex; align-items: center; gap: 0.5rem; transform: translate(-5px, -50%); white-space: nowrap; font-family: var(--font-mono); font-size: var(--step--1); color: var(--ink); }
  .co i { position: relative; width: 18px; height: 18px; border-radius: 50%; background: var(--lime); border: 1px solid var(--ink); flex: none; }
  .co i::before, .co i::after { content: ''; position: absolute; inset: 50% 4px auto; height: 1.5px; margin-top: -0.75px; background: var(--ink); }
  .co i::after { inset: 4px auto 4px 50%; width: 1.5px; height: auto; margin: 0 0 0 -0.75px; }
  :global(html.motion) .co i { animation: hs 2.4s var(--ease-out) infinite; }
  @keyframes hs { 0% { box-shadow: 0 0 0 0 rgba(187, 212, 64, 0.7); } 70%, 100% { box-shadow: 0 0 0 11px rgba(187, 212, 64, 0); } }
  .co b::after { content: ' \2197'; opacity: 0.6; }
  .co b { unicode-bidi: plaintext; font-weight: 400; background: var(--white); color: var(--ink); padding: 0.28rem 0.6rem; box-shadow: 0 6px 18px -10px rgba(0, 0, 0, 0.35); text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.72rem; }
  @media (min-width: 900px) {
    .stage[data-mode='3d'] .stage__art { height: clamp(18rem, 54svh, 42rem); }
  }
  li:global(.is-flip) .co { flex-direction: row-reverse; transform: translate(calc(-100% + 5px), -50%); }
</style>
