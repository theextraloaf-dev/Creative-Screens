---
import Base from '../../layouts/Base.astro';
import ServiceList from '../ServiceList.astro';
import Warehouse from '../Warehouse.astro';
import Stage from '../Stage.astro';
import Numbers from '../Numbers.astro';
import Why from '../Why.astro';
import { hl, messages, whatsappHref, type Locale } from '../../i18n';
import { site } from '../../config/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = messages(locale);
const wa = whatsappHref(site.whatsapp, m.wa.general);
---

<Base title={m.meta.homeTitle} description={m.meta.homeDesc} locale={locale} routeKey="home">
  <div slot="world"><Warehouse locale={locale} /></div>

  <!-- Hero: a full-bleed film (like mdscollective), with a poster until it plays. Files in /public/video:
       hero.mp4 (desktop), hero-sm.mp4 (phones), hero-poster.jpg. The current files are a PLACEHOLDER made from a client photo. -->
  <section class="hero" data-chapter="hero">
    <div class="hero__media" aria-hidden="true">
      <video class="hero__video" muted loop playsinline preload="metadata" poster="/video/hero-poster.jpg" data-hero-video>
        <source src="/video/hero-sm.mp4" type="video/mp4" media="(max-width: 700px)" />
        <source src="/video/hero.mp4" type="video/mp4" />
      </video>
      <div class="hero__scrim"></div>
    </div>
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal="fade">{m.hero.eyebrow}</p>
        <h1 data-text-reveal set:html={hl(m.hero.title)} />
        <p class="hero__lead" data-reveal data-delay="0.15">{m.hero.lead}</p>
        <div class="hero__cta" data-reveal data-delay="0.25">
          <a class="btn" href="#quote">{m.cta.quote} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href={wa} rel="noopener" target="_blank">{m.cta.whatsapp}</a>
        </div>
      </div>
      <p class="hero__proof eyebrow" data-reveal="fade" data-delay="0.35">{m.hero.proof}</p>
    </div>
    <p class="hero__cue eyebrow" aria-hidden="true"><span>{m.numbers.scroll}</span><i></i></p>
  </section>

  <div data-story>
    {m.story.chapters.map((c, i) => (
      <section class="chapter" data-chapter={i + 1} aria-labelledby={`ch-${i}`}>
        <div class="wrap chapter__in">
          <div class="chapter__text">
            <span class="eyebrow"><bdi dir="ltr">{c.n} / 04</bdi></span>
            <h2 id={`ch-${i}`}>{c.title}</h2>
            <p>{c.text}</p>
          </div>
        </div>
      </section>
    ))}
  </div>

  <Stage locale={locale} />
  <Numbers locale={locale} />
  <Why locale={locale} />
  <ServiceList locale={locale} />

  <section class="section cta" id="quote" aria-labelledby="quote-title">
    <div class="wrap cta__box">
      <h2 id="quote-title" data-text-reveal>{m.cta.quoteTitle}</h2>
      <div class="cta__actions" data-reveal>
        <a class="btn" href={wa} rel="noopener" target="_blank">{m.cta.whatsapp}</a>
        <p class="eyebrow">{locale === 'ar' ? 'نموذج طلب العرض يُضاف في المرحلة التالية' : 'Quote form arrives in the next build phase'}</p>
      </div>
    </div>
  </section>
</Base>

<script>
  /* Play the hero film only when motion is welcome; otherwise the poster stays. */
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const conn = (navigator as any).connection;
  if (v && document.documentElement.classList.contains('motion') && !conn?.saveData) {
    const go = () => v.play().catch(() => { /* autoplay blocked: the poster stays */ });
    go();
    // some browsers hold autoplay until the first interaction
    ['pointerdown', 'keydown', 'scroll'].forEach((ev) => window.addEventListener(ev, () => { if (v.paused) go(); }, { once: true, passive: true }));
  }
</script>

<style>
  .hero {
    position: relative; min-height: 100svh; display: grid; align-items: end; color: #fff; background: var(--deep);
    padding-block: calc(var(--header-h) + var(--space-5)) calc(var(--space-5) + 1rem);
  }
  .hero__media { position: absolute; inset: 0; overflow: hidden; }
  .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(19, 29, 39, 0.9) 0%, rgba(19, 29, 39, 0.5) 48%, rgba(19, 29, 39, 0.42) 100%);
  }
  .hero__grid { position: relative; display: grid; gap: var(--space-4); }
  .hero__copy { display: grid; gap: var(--space-3); justify-items: start; max-width: min(100%, 64rem); }
  .hero .eyebrow { color: rgba(255, 255, 255, 0.78); }
  h1 { font-size: var(--step-4); color: #fff; }
  .hero :global(mark) { background: var(--lime); color: var(--navy); padding: 0 0.14em; }
  .hero__lead { font-size: var(--step-1); color: rgba(255, 255, 255, 0.86); max-width: 34ch; }
  .hero__cta { display: grid; gap: 0.6rem; width: 100%; }
  .hero :global(.btn--ghost) { color: #fff; border-color: rgba(255, 255, 255, 0.85); }
  .hero :global(.btn--ghost)::before { background: #fff; }
  .hero :global(.btn--ghost:hover), .hero :global(.btn--ghost:focus-visible) { color: var(--navy); }
  .hero__cue { position: absolute; inset-block-end: 1.25rem; inset-inline-end: var(--gutter); display: none; align-items: center; gap: 0.75rem; }
  .hero__cue i { display: block; width: 1px; height: 3rem; background: rgba(255, 255, 255, 0.7); transform-origin: top; animation: cue 2.2s var(--ease-inout) infinite; }
  @keyframes cue { 0% { transform: scaleY(0); } 60% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero__cue i { animation: none; } }

  /* chapters: plain cards without the warehouse; a sticky text card that rides over the fly-through with it */
  .chapter { padding-block: var(--space-4); }
  .chapter__text { display: grid; gap: 0.75rem; max-width: 30rem; padding: 1.25rem 1.4rem; background: var(--white); border-radius: 4px; box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.35); }
  .chapter h2 { font-size: var(--step-3); }
  .chapter p { color: var(--grey); }
  :global(html.has-warehouse) .chapter { min-height: 110svh; padding: 0; }
  :global(html.has-warehouse) .chapter:last-child { min-height: 125svh; }
  :global(html.has-warehouse) .chapter__in { position: sticky; top: 0; height: 100svh; display: grid; align-content: end; padding-block-end: calc(var(--space-4) + 4rem); }

  .cta { background: var(--lime); color: var(--navy); }
  .cta :global(h2), .cta :global(p) { color: var(--navy); }
  .cta__box { display: grid; gap: var(--space-4); }
  .cta__actions { display: grid; gap: var(--space-2); justify-items: start; }
  .cta .btn { --btn-bg: var(--navy); --btn-fg: var(--lime); border-color: var(--navy); }
  .cta .btn::before { background: #fff; }
  .cta .btn:hover, .cta .btn:focus-visible { color: var(--navy); }
  .cta .eyebrow { color: var(--navy); }
  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: 1fr auto; align-items: end; }
    .hero__cta { grid-template-columns: auto auto; width: auto; }
    .hero__proof { max-width: 20rem; text-align: end; }
    .hero__cue { display: flex; }
    :global(html.has-warehouse) .chapter__in { align-content: center; padding-block-end: 0; }
    :global(html.has-warehouse) .chapter__text { max-width: 24rem; }
    .cta__box { grid-template-columns: 1.4fr 1fr; align-items: end; }
  }
</style>
