---
import Base from '../../layouts/Base.astro';
import ServiceList from '../ServiceList.astro';
import Warehouse from '../Warehouse.astro';
import Stage from '../Stage.astro';
import Numbers from '../Numbers.astro';
import Why from '../Why.astro';
import { hl, messages, whatsappHref, type Locale } from '../../i18n';
import { site } from '../../config/site';
import { ringPath } from '../../scripts/carousel.js';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = messages(locale);
const wa = whatsappHref(site.whatsapp, m.wa.general);
const T = m.story.ticket;
const ring = ringPath(100, 100, 92, 86, 5);
---

<Base title={m.meta.homeTitle} description={m.meta.homeDesc} locale={locale} routeKey="home">
  <div slot="world"><Warehouse locale={locale} /></div>

  <!-- Hero: a full-bleed film (like mdscollective), with a poster until it plays. Files in /public/video:
       hero.mp4 (desktop), hero-sm.mp4 (phones), hero-poster.jpg. The current files are a PLACEHOLDER made from a client photo. -->
  <section class="hero" data-chapter="hero">
    <div class="hero__media" aria-hidden="true">
      <video class="hero__video" muted loop playsinline preload="metadata" poster="/video/hero-poster.jpg" data-hero-video>
        <source src="/video/hero-sm.mp4" type="video/mp4" media="(max-width: 700px)" />
        <source src="/video/hero.mp4" type="video/mp4" />
      </video>
      <div class="hero__scrim"></div>
    </div>
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal="fade">{m.hero.eyebrow}</p>
        <h1 data-text-reveal set:html={hl(m.hero.title)} />
        <p class="hero__lead" data-reveal data-delay="0.15">{m.hero.lead}</p>
        <div class="hero__cta" data-reveal data-delay="0.25">
          <a class="btn" href="#quote">{m.cta.quote} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href={wa} rel="noopener" target="_blank">{m.cta.whatsapp}</a>
        </div>
      </div>
      <p class="hero__proof eyebrow" data-reveal="fade" data-delay="0.35">{m.hero.proof}</p>
    </div>
    <p class="hero__cue eyebrow" aria-hidden="true"><span>{m.numbers.scroll}</span><i></i></p>
  </section>

  <!-- What we make: the workshop builds itself behind the service cards, right after the hero -->
  <ServiceList locale={locale} />

  <!-- How a job runs: four print-shop job tickets in an A24-style carousel over the 3D print works
       (src/scripts/tickets.js); the warehouse fly-through follows the scroll through this block -->
  <div class="story" data-story>
    <div class="story__pin">
      <svg class="story__ring" viewBox="0 0 200 200" preserveAspectRatio="none" aria-hidden="true"><path d={ring} pathLength="1"></path></svg>
      <div class="story__track">
    {m.story.chapters.map((c, i) => (
      <section class="chapter" data-chapter={i + 1} aria-labelledby={`ch-${i}`}>
          <!-- a print-shop job ticket: docket header, big numeral, ruled stage rows, a rubber stamp, tear-off barcode -->
          <div class="ticket">
            <p class="ticket__head"><span>{T.label}</span><span class="ltr">{T.no} CS-0421 · {c.n}</span></p>
            <p class="ticket__no ltr" aria-hidden="true">{c.n}<small>/04</small></p>
            <h2 id={`ch-${i}`} class="ticket__title">{c.title}</h2>
            <p class="ticket__text">{c.text}</p>
            <dl class="ticket__rows">
              <div><dt>{T.stage}</dt><dd>{T.stages[i]}</dd></div>
              <div><dt>{T.next}</dt><dd>{i < 3 ? m.story.chapters[i + 1].title : T.last}</dd></div>
            </dl>
            <ol class="ticket__bar" aria-hidden="true">{[0, 1, 2, 3].map((k) => <li class={k <= i ? 'is-done' : ''}></li>)}</ol>
            <p class="ticket__stamp" aria-hidden="true"><span>{T.stamps[i]}</span></p>
            <p class="ticket__tear" aria-hidden="true"><i></i></p>
          </div>
      </section>
    ))}
      </div>
    </div>
  </div>

  <Stage locale={locale} />
  <Numbers locale={locale} />
  <Why locale={locale} />

  <section class="section cta" id="quote" aria-labelledby="quote-title">
    <div class="wrap cta__box">
      <h2 id="quote-title" data-text-reveal>{m.cta.quoteTitle}</h2>
      <div class="cta__actions" data-reveal>
        <a class="btn" href={wa} rel="noopener" target="_blank">{m.cta.whatsapp}</a>
        <p class="eyebrow">{locale === 'ar' ? 'نموذج طلب العرض يُضاف في المرحلة التالية' : 'Quote form arrives in the next build phase'}</p>
      </div>
    </div>
  </section>
</Base>

<script>
  /* Play the hero film only when motion is welcome; otherwise the poster stays. */
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const conn = (navigator as any).connection;
  if (v && document.documentElement.classList.contains('motion') && !conn?.saveData) {
    const go = () => v.play().catch(() => { /* autoplay blocked: the poster stays */ });
    go();
    // some browsers hold autoplay until the first interaction
    ['pointerdown', 'keydown', 'scroll'].forEach((ev) => window.addEventListener(ev, () => { if (v.paused) go(); }, { once: true, passive: true }));
  }
</script>

<style>
  .hero {
    position: relative; min-height: 100svh; display: grid; align-items: end; color: #fff; background: var(--deep);
    padding-block: calc(var(--header-h) + var(--space-5)) calc(var(--space-5) + 1rem);
  }
  .hero__media { position: absolute; inset: 0; overflow: hidden; }
  .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(19, 29, 39, 0.9) 0%, rgba(19, 29, 39, 0.5) 48%, rgba(19, 29, 39, 0.42) 100%);
  }
  .hero__grid { position: relative; display: grid; gap: var(--space-4); }
  .hero__copy { display: grid; gap: var(--space-3); justify-items: start; max-width: min(100%, 64rem); }
  .hero .eyebrow { color: rgba(255, 255, 255, 0.78); }
  h1 { font-size: var(--step-4); color: #fff; }
  .hero :global(mark) { background: var(--lime); color: var(--navy); padding: 0 0.14em; }
  .hero__lead { font-size: var(--step-1); color: rgba(255, 255, 255, 0.86); max-width: 34ch; }
  .hero__cta { display: grid; gap: 0.6rem; width: 100%; }
  .hero :global(.btn--ghost) { color: #fff; border-color: rgba(255, 255, 255, 0.85); }
  .hero :global(.btn--ghost)::before { background: #fff; }
  .hero :global(.btn--ghost:hover), .hero :global(.btn--ghost:focus-visible) { color: var(--navy); }
  .hero__cue { position: absolute; inset-block-end: 1.25rem; inset-inline-end: var(--gutter); display: none; align-items: center; gap: 0.75rem; }
  .hero__cue i { display: block; width: 1px; height: 3rem; background: rgba(255, 255, 255, 0.7); transform-origin: top; animation: cue 2.2s var(--ease-inout) infinite; }
  @keyframes cue { 0% { transform: scaleY(0); } 60% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero__cue i { animation: none; } }

  /* job tickets: a row of tickets without motion; with motion an A24-style carousel over the 3D print works */
  .story__pin { width: min(100% - var(--gutter) * 2, var(--maxw)); margin-inline: auto; padding-block: var(--space-5); }
  .story__track { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); justify-items: center; }
  .story__ring { display: none; }
  :global(html.motion) .story { height: 440svh; }
  :global(html.motion) .story__pin { position: sticky; top: 0; width: auto; height: 100svh; padding: 0; overflow: hidden; }
  :global(html.motion) .story__track { display: block; position: absolute; left: 50%; top: 55%; width: 0; height: 0; }
  :global(html.motion) .chapter { position: absolute; left: 0; top: 0; width: min(84vw, 23rem); will-change: transform; }
  :global(html.motion) .chapter .ticket { width: 100%; }
  :global(html.motion) .story__ring { display: block; position: absolute; left: 50%; top: 55%; width: calc(min(84vw, 23rem) * 1.32); height: min(44rem, 84svh); transform: translate(-50%, -50%) rotate(-5deg); overflow: visible; pointer-events: none; z-index: 150; }
  .story__ring path { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linecap: round; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: var(--ring, 1); }
  .ticket {
    position: relative; display: grid; gap: 0.6rem; width: min(100%, 23rem); padding: 1rem 1.15rem 0; background: var(--white); color: var(--ink);
    border: 1px solid var(--ink); box-shadow: 0 22px 40px -26px rgba(0, 0, 0, 0.45);
    /* notches where the stub tears off */
    -webkit-mask: radial-gradient(circle 9px at 0 calc(100% - 3.1rem), transparent 98%, #000) , radial-gradient(circle 9px at 100% calc(100% - 3.1rem), transparent 98%, #000);
    -webkit-mask-composite: source-in; mask-composite: intersect;
  }
  .ticket__head { display: flex; justify-content: space-between; gap: 1rem; padding-block-end: 0.45rem; border-block-end: 2px solid var(--ink); font-family: var(--font-mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .ticket__no { font-family: var(--font-num); font-size: clamp(5rem, 3.5rem + 6vw, 8.5rem); line-height: 0.8; color: transparent; -webkit-text-stroke: 1.5px var(--ink); margin-block-start: 0.3rem; }
  .ticket__no { justify-self: start; } /* numeral on the reading side, stamp on the other */
  .ticket__no small { font-size: 0.32em; -webkit-text-stroke: 0; color: var(--ink); margin-inline-start: 0.2em; }
  .ticket__title { font-family: var(--font-num); font-weight: 400; text-transform: uppercase; font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem); line-height: 0.92; }
  html[lang='ar'] .ticket__title { font-family: var(--font-display); font-weight: 700; text-transform: none; line-height: 1.3; }
  .ticket__text { color: var(--grey); font-size: var(--step--1); max-width: 34ch; }
  .ticket__rows { margin: 0; border-block-end: 1px solid var(--ink); }
  .ticket__rows > div { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.3rem; border-block-start: 1px solid var(--ink); font-size: 0.82rem; }
  .ticket__rows dt { font-weight: 700; font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.08em; padding-block-start: 0.15rem; }
  .ticket__rows dd { margin: 0; }
  html[lang='ar'] .ticket__head, html[lang='ar'] .ticket__rows dt { text-transform: none; letter-spacing: 0; }
  .ticket__bar { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }
  .ticket__bar li { height: 6px; border: 1px solid var(--ink); }
  .ticket__bar li.is-done { background: var(--ink); }
  .ticket__bar li.is-done:last-child, .ticket__bar li.is-done:not(:has(+ .is-done)) { background: var(--lime); }
  .ticket__tear { margin: 0.4rem -1.15rem 0; padding: 0.7rem 1.15rem 0.8rem; border-block-start: 2px dashed var(--ink); }
  .ticket__tear i { display: block; height: 1.6rem; background: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 4px, var(--ink) 4px 5px, transparent 5px 8px, var(--ink) 8px 11px, transparent 11px 13px); }
  /* rubber stamp: thumps on when the chapter is on screen */
  .ticket__stamp { position: absolute; inset-block-start: 3.2rem; inset-inline-end: 0.9rem; pointer-events: none; }
  .ticket__stamp span {
    display: inline-block; padding: 0.3rem 0.65rem; border: 3px solid var(--ink); border-radius: 6px; background: color-mix(in srgb, var(--lime) 88%, transparent);
    font-family: var(--font-num); font-size: 1.35rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink); transform: rotate(-9deg);
    box-shadow: inset 0 0 0 2px var(--lime), inset 0 0 0 3px var(--ink);
  }
  html[lang='ar'] .ticket__stamp span { font-family: var(--font-display); font-weight: 700; text-transform: none; font-size: 1.05rem; }
  :global(html.motion) .ticket__stamp span { opacity: 0; transform: rotate(-9deg) scale(1.9); transition: opacity 0.18s ease-out, transform 0.32s cubic-bezier(0.2, 1.4, 0.4, 1); }
  :global(html.motion) .chapter:global(.is-stamped) .ticket__stamp span { opacity: 1; transform: rotate(-9deg) scale(1); }

  .cta { background: var(--lime); color: var(--navy); }
  .cta :global(h2), .cta :global(p) { color: var(--navy); }
  .cta__box { display: grid; gap: var(--space-4); }
  .cta__actions { display: grid; gap: var(--space-2); justify-items: start; }
  .cta .btn { --btn-bg: var(--navy); --btn-fg: var(--lime); border-color: var(--navy); }
  .cta .btn::before { background: #fff; }
  .cta .btn:hover, .cta .btn:focus-visible { color: var(--navy); }
  .cta .eyebrow { color: var(--navy); }
  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: 1fr auto; align-items: end; }
    .hero__cta { grid-template-columns: auto auto; width: auto; }
    .hero__proof { max-width: 20rem; text-align: end; }
    .hero__cue { display: flex; }
    .cta__box { grid-template-columns: 1.4fr 1fr; align-items: end; }
  }
</style>
