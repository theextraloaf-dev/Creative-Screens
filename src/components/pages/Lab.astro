---
/* Motion lab: every primitive in one place, in this language. Not indexed. */
import Base from '../../layouts/Base.astro';
import Stage from '../Stage.astro';
import { hl, messages, type Locale } from '../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = messages(locale);
const L = m.lab;

const lum = (hex: string) => {
  const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const ratio = (a: string, b: string) => {
  const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p);
  return (x + 0.05) / (y + 0.05);
};
const pairs = [
  { name: 'Ink on paper', fg: '#111111', bg: '#f7f5f0', use: 'body text' },
  { name: 'Grey on paper', fg: '#5b5b55', bg: '#f7f5f0', use: 'secondary text' },
  { name: 'Ink on lime', fg: '#111111', bg: '#c8f31d', use: 'buttons' },
  { name: 'Lime on ink', fg: '#c8f31d', bg: '#111111', use: 'button hover' },
  { name: 'Lime on paper', fg: '#c8f31d', bg: '#f7f5f0', use: 'NEVER as text' },
  { name: 'Signal on paper', fg: '#e8432a', bg: '#f7f5f0', use: 'decoration only' },
].map((p) => ({ ...p, r: ratio(p.fg, p.bg) }));
---

<Base title={m.meta.labTitle} description={L.intro} locale={locale} routeKey="lab" noindex>
  <section class="section head">
    <div class="wrap">
      <p class="eyebrow">noindex</p>
      <h1 data-text-reveal>{L.title}</h1>
      <p class="lead" data-reveal>{L.intro}</p>
      <p class="eyebrow" data-reveal data-delay="0.1">{L.reduced}</p>
    </div>
  </section>

  <section class="section lab" aria-labelledby="l-type">
    <div class="wrap">
      <h2 id="l-type">{L.type}</h2>
      <div class="specimen">
        <p class="eyebrow">Display / eyebrow</p>
        <p class="d1" set:html={hl(m.hero.title)} />
        <p>{m.hero.proof} {m.hero.lead}</p>
        <p class="eyebrow">
          {locale === 'ar' ? 'الأرقام تبقى لاتينية:' : 'Digits and contacts:'} <span class="ltr">+968 XXXX XXXX · 2026</span>
        </p>
      </div>
      <table class="contrast">
        <thead><tr><th>Pair</th><th>Use</th><th>Ratio</th><th>AA text</th></tr></thead>
        <tbody>
          {pairs.map((p) => (
            <tr>
              <td><span class="chip" style={`background:${p.bg};color:${p.fg}`}>Aa</span> {p.name}</td>
              <td>{p.use}</td>
              <td class="ltr">{p.r.toFixed(1)}:1</td>
              <td>{p.r >= 4.5 ? 'pass' : 'fail'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section lab" aria-labelledby="l-btn">
    <div class="wrap">
      <h2 id="l-btn">{L.buttons}</h2>
      <div class="row">
        <a class="btn" href="#quote">{m.cta.quote} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#quote">{m.cta.whatsapp}</a>
      </div>
    </div>
  </section>

  <section class="section lab" aria-labelledby="l-rev">
    <div class="wrap">
      <h2 id="l-rev">{L.reveal}</h2>
      <div class="cards">
        <div class="card" data-reveal>up</div>
        <div class="card" data-reveal data-delay="0.08">up + delay</div>
        <div class="card" data-reveal="inline" data-delay="0.16">inline ({locale === 'ar' ? 'RTL' : 'LTR'})</div>
        <div class="card" data-reveal="fade" data-delay="0.24">fade</div>
      </div>
    </div>
  </section>

  <section class="section lab" aria-labelledby="l-text">
    <div class="wrap">
      <h2 id="l-text">{L.text}</h2>
      <p class="statement" data-text-reveal>{L.textSample}</p>
    </div>
  </section>

  <section class="section lab" aria-labelledby="l-blur">
    <div class="wrap">
      <h2 id="l-blur">{L.blur}</h2>
      <p class="statement" data-blur-in>{L.blurSample}</p>
    </div>
  </section>

  <section class="section lab" aria-labelledby="l-clip">
    <div class="wrap">
      <h2 id="l-clip">{L.clip}</h2>
      <div class="clip" data-clip><div class="ph" style="min-height:18rem">{m.placeholder}</div></div>
    </div>
  </section>

  <section class="section lab" aria-labelledby="l-count">
    <div class="wrap">
      <h2 id="l-count">{L.count}</h2>
      <div class="stats">
        <div class="stat"><span class="n ltr" data-count="21">21</span><span class="eyebrow">{L.years}</span></div>
        <div class="stat"><span class="n ltr" data-count="500">500</span><span class="eyebrow">{L.clients}</span></div>
        <div class="stat"><span class="n ltr" data-count="2000">2000</span><span class="eyebrow">{L.projects}</span></div>
      </div>
    </div>
  </section>

  <Stage locale={locale} id="lab-stage" />

  <section class="section cta" id="quote">
    <div class="wrap"><h2>{m.cta.quoteTitle}</h2></div>
  </section>
</Base>

<style>
  .head { padding-block-start: calc(var(--header-h) + var(--space-5)); }
  h1 { font-size: var(--step-4); margin-block: var(--space-2); }
  .lead { font-size: var(--step-1); color: var(--grey); max-width: 48ch; margin-block-end: var(--space-2); }
  .lab { border-block-start: 1px solid var(--hairline); padding-block: var(--space-5); }
  .lab h2 { font-size: var(--step-2); margin-block-end: var(--space-3); }
  .specimen { display: grid; gap: var(--space-2); max-width: 60rem; }
  .d1 { font-family: var(--font-display); font-weight: 600; font-size: var(--step-3); line-height: var(--lh-display); }
  .contrast { margin-block-start: var(--space-4); width: 100%; border-collapse: collapse; font-size: var(--step--1); }
  .contrast th, .contrast td { text-align: start; padding: 0.6rem 0.5rem; border-block-end: 1px solid var(--hairline); }
  .chip { display: inline-grid; place-items: center; width: 2.4rem; height: 1.8rem; border-radius: 6px; border: 1px solid var(--hairline); font-weight: 700; margin-inline-end: 0.5rem; }
  .row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .cards { display: grid; gap: 0.75rem; grid-template-columns: repeat(2, 1fr); }
  .card { padding: var(--space-4) var(--space-2); background: var(--white); border: 1px solid var(--hairline); border-radius: var(--radius); font-family: var(--font-mono); }
  .statement { font-family: var(--font-display); font-weight: 600; font-size: var(--step-3); line-height: var(--lh-display); max-width: 22ch; }
  .clip { border-radius: var(--radius); }
  .stats { display: grid; gap: var(--space-3); }
  .stat { display: grid; gap: 0.25rem; border-block-start: 1px solid var(--ink); padding-block-start: var(--space-2); }
  .n { font-family: var(--font-display); font-weight: 600; font-size: var(--step-4); line-height: 1; }
  .cta { background: var(--lime); border-block: 1.5px solid var(--ink); padding-block: var(--space-5); }
  @media (min-width: 720px) {
    .cards { grid-template-columns: repeat(4, 1fr); }
    .stats { grid-template-columns: repeat(3, 1fr); }
  }
</style>
