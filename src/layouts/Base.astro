---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { site, isStaging } from '../config/site';
import { dirOf, hrefFor, messages, type Locale, type RouteKey } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  routeKey: RouteKey;
  noindex?: boolean;
}
const { title, description, locale, routeKey, noindex = false } = Astro.props;
const m = messages(locale);
const abs = (path: string) => new URL(path, site.url).href;
const robots = noindex || isStaging ? 'noindex, nofollow' : 'index, follow';
---

<!doctype html>
<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ededed" />
    <link rel="canonical" href={abs(hrefFor(routeKey, locale))} />
    <link rel="alternate" hreflang="en" href={abs(hrefFor(routeKey, 'en'))} />
    <link rel="alternate" hreflang="ar" href={abs(hrefFor(routeKey, 'ar'))} />
    <link rel="alternate" hreflang="x-default" href={abs(hrefFor(routeKey, 'en'))} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23131d27'/%3E%3Crect x='6' y='13' width='20' height='6' fill='%23bbd440'/%3E%3C/svg%3E" />
    <script is:inline>
      /* Motion is allowed only when JS runs and the visitor has not asked to reduce it.
         The "21 years" loader shows once per session, and only when motion is allowed.
         If the motion script has not taken over after 7 s, drop the hidden start states. */
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion');
          var seen = false;
          try { seen = sessionStorage.getItem('cs-loader') === '1'; } catch (e) {}
          if (!seen) d.classList.add('loader-on');
          setTimeout(function () {
            if (!window.__motionReady) d.classList.remove('motion', 'loader-on');
          }, 7000);
        }
      })();
    </script>
  </head>
  <body>
    <div class="loader" data-loader role="status" aria-live="polite">
      <div class="loader__in">
        <span class="loader__logo" role="img" aria-label="Creative Screens"></span>
        <p class="loader__num"><span data-loader-num class="ltr">21</span></p>
        <p class="loader__label">{m.loader.label}</p>
        <span class="loader__bar" aria-hidden="true"><i data-loader-bar></i></span>
      </div>
    </div>
    <a class="skip-link" href="#main">{locale === 'ar' ? 'انتقل إلى المحتوى' : 'Skip to content'}</a>
    <Header locale={locale} routeKey={routeKey} />
    <slot name="world" />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} routeKey={routeKey} />
    <StickyCta locale={locale} />
    <script is:inline>
      /* The loader: counts to 21 and stops, then lifts away. Tap or press Escape to skip. */
      (function () {
        var d = document.documentElement;
        if (!d.classList.contains('loader-on')) return;
        var el = document.querySelector('[data-loader]');
        var num = el.querySelector('[data-loader-num]'), bar = el.querySelector('[data-loader-bar]');
        var T = 1500, t0 = performance.now(), done = false;
        num.textContent = '0';
        function finish() {
          if (done) return; done = true;
          el.classList.add('is-out');
          setTimeout(function () {
            d.classList.remove('loader-on');
            try { sessionStorage.setItem('cs-loader', '1'); } catch (e) {}
            window.dispatchEvent(new Event('cs:loader-done'));
          }, 800);
        }
        function step(now) {
          var t = Math.min(1, (now - t0) / T), e = 1 - Math.pow(1 - t, 3);
          num.textContent = String(Math.round(e * 21));
          bar.style.transform = 'scaleX(' + e + ')';
          if (t < 1) requestAnimationFrame(step); else { el.classList.add('is-full'); setTimeout(finish, 700); }
        }
        requestAnimationFrame(step);
        el.addEventListener('click', finish);
        addEventListener('keydown', function (e) { if (e.key === 'Escape') finish(); });
        setTimeout(finish, 4500);
      })();
    </script>
    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>
